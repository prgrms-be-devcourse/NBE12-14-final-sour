# GEMINI_API_KEY: Gemini AI API 호출에 필요하다.
# AI Studio가 실행 시 사용자 시크릿에서 자동으로 넣어 준다.
# 사용자는 AI Studio UI의 Secrets 패널에서 설정한다.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: 이 앱이 호스팅되는 URL.
# AI Studio가 실행 시 Cloud Run 서비스 URL을 자동으로 넣어 준다.
# 자기 자신을 가리키는 링크, OAuth 콜백, API 엔드포인트에 쓴다.
APP_URL="MY_APP_URL"

# VITE_API_MODE: 로컬 개발과 `npm run build -- --mode campus-test`에서 쓸 데이터 출처.
# 비우거나 "mock"이면 목업 데이터(fixture)를 쓰고, "api"면 백엔드를 호출한다. 일반 서비스 빌드는 항상 API를 쓰고 목업 도구를 넣지 않는다.
# `npm run dev`는 "api"(커밋된 .env.api), `npm run dev:mock`은 "mock"(.env.mock)으로 설정하므로 로컬 개발에서는 여기에 값을 넣지 않아도 된다.
# VITE_API_MODE="api"

# VITE_API_ORIGIN: 운영 API origin (예: https://api.<도메인>).
# 비우면 같은 origin을 사용한다. npm run dev와 vite preview는 Vite proxy로 /api와 /ws를 전달한다.
# 경로 없이 https를 사용한다. localhost, 127.0.0.1, [::1]에서는 http도 허용한다.
# Vercel Production 빌드에서는 필수이며 없으면 빌드가 실패한다. Preview는 mock 모드이므로 넣지 않는다.
# VITE_API_ORIGIN=""

# 연합 초대 API와 V19 마이그레이션이 배포된 API 환경에서만 초대 탭을 켠다.
# VITE_ALLIANCE_INVITATIONS="true"

# API_PROXY_TARGET: 개발 서버와 미리보기(preview) 서버가 /api와 /ws 요청을 전달할 백엔드 주소. 개발 서버 전용이다
# (VITE_ 접두사가 없어 브라우저에는 노출되지 않는다). 비우면 http://localhost:8080.
# API_PROXY_TARGET="http://localhost:8080"

# VITE_TURNSTILE_SITEKEY: 봇 확인용 Cloudflare Turnstile 사이트 키 (SCRUM-121). 공개 값이며 비밀값이 아니다.
# 비우면 Cloudflare 테스트 사이트 키(항상 통과)를 쓴다. Turnstile secret은 절대 VITE_ 변수에 넣지 않는다.
# VITE_TURNSTILE_SITEKEY=""


VITE_TOSS_CLIENT_KEY=CHANGE_ME