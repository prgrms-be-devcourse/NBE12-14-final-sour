# [필수] JWT HS256 서명 키, UTF-8 기준 32바이트 이상
# 생성: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
# [선택] CORS 허용 origin, 쉼표로 구분. 주석 처리해 두면 기본값 http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Redis URL은 나중에 Redis 서버 운영 시 사용
REDIS_URL=

# [필수] 학교 이메일 암호화 키(AES-256-GCM), Base64로 인코딩한 32바이트
# 생성: openssl rand -base64 32
EMAIL_ENCRYPTION_KEY=CHANGE_ME
# [필수] 이메일 조회용 해시 키(HMAC-SHA256), Base64로 인코딩한 32바이트 이상. 바꾸면 기존 회원을 이메일로 찾을 수 없다
# 생성: openssl rand -base64 32
EMAIL_HASH_KEY=CHANGE_ME

# [prod 필수, 로컬 선택] 인증 메일 SMTP. SPRING_MAIL_HOST가 없으면 로컬에서는 코드를 로그로 남기고, prod에서는 앱이 시작하지 않는다
# Gmail은 앱 비밀번호를 쓴다 (포트 587, STARTTLS는 application.yaml에서 켬)
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# [선택] 발신 주소. 비우면 SPRING_MAIL_USERNAME
# VERIFICATION_MAIL_FROM=

# [선택] 어뷰징 의심 시 Cloudflare Turnstile 봇 확인. 주석 처리해 두면 꺼짐(지금과 동작이 같음)
# 켜면 TURNSTILE_SECRET과 TURNSTILE_HOSTNAMES가 필수이고, 빠지면 앱이 시작하지 않는다
# secret은 저장소·채팅에 올리지 않고 DM으로 받는다. prod의 TURNSTILE_HOSTNAMES에는 localhost·127.0.0.1을 넣을 수 없다
# TURNSTILE_ENABLED=true
# TURNSTILE_SECRET=
# TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# [선택] 업로드한 파일을 내려주는 공개 주소(CloudFront). 프로필 이미지 URL 검사에 쓴다. 주석 처리해 두면 기본값 https://cdn.devcproject.cloud
# FILE_PUBLIC_BASE_URL=https://cdn.devcproject.cloud


# [prod 필수, 로컬 불필요] 로고 이미지를 올리는 S3 버킷 이름. 로컬·테스트는 기본값 local-logo-bucket(Floci 에뮬레이터)을 쓴다
# prod에서 빠지면 앱이 시작하지 않는다
# FILE_LOGO_BUCKET=
# [선택] S3 리전. 주석 처리해 두면 기본값 ap-northeast-2(서울)
# AWS_REGION=ap-northeast-2
# [선택] 로고 이미지 주소의 앞부분. 로컬 기본값 http://localhost:4566/{버킷}(Floci), prod 기본값은 FILE_PUBLIC_BASE_URL
# FILE_LOGO_PUBLIC_BASE_URL=
# AWS 액세스 키는 넣지 않는다. 운영은 EC2 IAM 역할, 로컬·테스트는 에뮬레이터를 쓴다

# [선택] 개발자 공용 계정 (와플대학교 소속). 이메일과 비밀번호를 넣으면 앱이 시작될 때 계정이 없으면 만든다. 하나라도 비우면 만들지 않는다
# 아래 이메일은 형식 예시다. 실제 팀 계정 주소와 비밀번호는 저장소·채팅에 올리지 않고 팀원에게 DM으로 받는다
# 비밀번호는 회원가입 규칙(8~64자, 영문·숫자·특수문자)을 따른다
# DEV_ACCOUNT_EMAIL=dev-account@example.com
# 로컬 기본값은 켜짐·ADMIN, prod는 꺼짐·USER (prod에서 쓰려면 DEV_ACCOUNT_ENABLED=true)
# DEV_ACCOUNT_PASSWORD=
# DEV_ACCOUNT_ENABLED=true
# DEV_ACCOUNT_ROLE=ADMIN
